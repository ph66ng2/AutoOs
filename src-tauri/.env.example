# Ambiente descartável de staging — nunca use credenciais da BMITAG.
# Copie para src-tauri/.env apenas na sua máquina e preencha os placeholders.

# Banco PostgreSQL do projeto Supabase exclusivo de staging (TLS obrigatório).
DATABASE_URL=postgresql://postgres:<STAGING_DB_PASSWORD>@db.<STAGING_PROJECT_REF>.supabase.co:5432/postgres?sslmode=require

# Endpoint do projeto Supabase de staging. Chaves privilegiadas ficam somente no
# cofre de segredos/ambiente local de operações; nunca no app distribuído.
SUPABASE_URL=https://<STAGING_PROJECT_REF>.supabase.co
AUTOOS_MOBILE_PHOTO_UPLOADER_URL=https://<STAGING_VERCEL_DOMAIN>/upload
SUPABASE_SERVICE_ROLE_KEY=<STAGING_SERVICE_ROLE_KEY_LOCAL_ONLY>

# Instância PowerSync exclusiva de staging e token de curta duração para testes.
POWERSYNC_URL=wss://<STAGING_POWERSYNC_INSTANCE>.powersync.journeyapps.com/v2/ws
POWERSYNC_TOKEN=<STAGING_POWERSYNC_TOKEN_LOCAL_ONLY>
