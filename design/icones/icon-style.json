   "source": "scan: lucide-react 100 imports, default stroke 2"
  },
  {
   "decision": "segundo tom: preenchimento de 28%",
   "because": "com 16% o preenchimento sumia a 18px no menu (teste no app real)",
   "source": "print do menu, rodada 1"
  },
  {
   "decision": "canto 2.5",
   "because": "--radius é 8px; cerca de 0,3x no grid 24",
   "source": "src/index.css:30"
  },
  {
   "decision": "ativo no teal da marca",
   "because": "--primary 192 56% 28% (claro) e 192 29% 59% (escuro)",
   "source": "src/index.css:13"
  },
  {
   "decision": "tamanhos 16, 18 e 24",
   "because": "o menu lateral usa 18px; listas e botões 16px",
   "source": "src/components/Layout.tsx:240"
  }
 ]
